{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "harmonized_sample.schema.json",
  "title": "Harmonized single-cell sample record",
  "description": "Structural rules only. Whether an ontology ID exists, is current, and sits in the right branch is checked separately against the pinned ontology files.",
  "x-schema-version": "1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sample_id", "study_id", "donor_id",
    "organism_ontology_term_id", "sex_ontology_term_id",
    "tissue_ontology_term_id", "disease_ontology_term_id",
    "assay_ontology_term_id", "suspension_type",
    "age_min_years", "age_max_years", "age_raw", "schema_version"
  ],
  "properties": {
    "sample_id": {"type": "string", "pattern": "^[A-Z]_S[0-9]{2}$"},
    "study_id": {"type": "string", "enum": ["A", "B", "C"]},
    "donor_id": {"type": "string", "pattern": "^[A-Z]_D[0-9]{2}$"},
    "organism_ontology_term_id": {"const": "NCBITaxon:9606"},
    "sex_ontology_term_id": {"enum": ["PATO:0000383", "PATO:0000384", "unknown"]},
    "tissue_ontology_term_id": {"type": "string", "pattern": "^UBERON:[0-9]{7}$"},
    "disease_ontology_term_id": {"type": "string", "pattern": "^(MONDO:[0-9]{7}|PATO:0000461)$"},
    "assay_ontology_term_id": {"type": "string", "pattern": "^EFO:[0-9]{7}$"},
    "suspension_type": {"enum": ["cell", "nucleus"]},
    "age_min_years": {"type": ["number", "null"], "minimum": 0, "maximum": 120},
    "age_max_years": {"type": ["number", "null"], "minimum": 0, "maximum": 120},
    "age_raw": {"type": "string", "description": "Submitted value, kept verbatim."},
    "schema_version": {"const": "1.0.0"}
  }
}
